# Copy to .env and fill in as needed. Never commit the real .env file.
DATABASE_URL=sqlite:///./nlp_nexus.db

# Only needed once real translation/HF Hub downloads are used in later phases.
# HF_HOME=./.hf_cache

# --- Auth (Milestone 17) ---
# MUST be overridden with a long random secret before any real deployment —
# the code ships a dev-only fallback and will not refuse to start without
# this, but every signed session and verification link is forgeable if you
# don't set it.
JWT_SECRET=change-me-to-a-long-random-string

# --- Account Creation & Email Verification (Milestone 18) ---
# Set to "false" to skip email verification entirely (new accounts are
# marked verified immediately and no "Verify Email" button is sent).
EMAIL_VERIFICATION_ENABLED=true

# Where the "Verify Email / Activate Account" link in the welcome email
# points — the frontend origin serving /verify-email, not the API.
FRONTEND_BASE_URL=http://localhost:5173

# Shown in the email's security note ("contact ... if you did not create
# this account"). Falls back to a generic "your platform administrator"
# if left unset.
SUPPORT_EMAIL=

# Real SMTP credentials for actually sending the "Account created
# successfully" email. Leave these unset in development — the backend
# then honestly logs that email delivery was skipped (SMTP not
# configured) instead of pretending an email went out, and registration
# still succeeds normally. Works with Gmail (use an App Password, not
# your real password), SendGrid/Mailgun/Resend/SES's SMTP relay, or any
# other SMTP provider — never hardcode these values in source, and never
# expose them to the frontend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NeuroNLP Nexus
SMTP_USE_TLS=true
