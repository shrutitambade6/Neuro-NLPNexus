# Copy to .env (or .env.local) and uncomment to override. Vite only
# exposes variables prefixed VITE_ to the browser.

# Dev-only API diagnostics panel (frontend/src/components/ApiDiagnosticsPanel.tsx).
# Shows which leg of a request failed (frontend -> backend vs backend ->
# database) while debugging a connectivity issue. Only ever rendered in a
# dev build (import.meta.env.DEV) AND when this is explicitly "true" — it
# never appears to a real student, and a plain `npm run dev` with no .env
# override stays silent by default.
VITE_SHOW_API_DIAGNOSTICS=false
